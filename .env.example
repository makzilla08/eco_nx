# คัดลอกเป็น .env แล้วเติมค่า — .env* ถูก gitignore ไว้แล้ว
# บน Codespaces ใช้ Secrets แทนไฟล์: Settings → Secrets → Codespaces

# ปลายทางของ /api/* เมื่อไม่มีไฟล์ api/<name>.js ที่รันในเครื่อง (default = live Vercel)
API_TARGET=https://econx-three.vercel.app

# พอร์ต dev server
PORT=8099

# Cloudflare Worker (hls-worker/) — ต้องมีก่อน npm run worker:deploy
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# smoke test
SMOKE_URL=http://127.0.0.1:8099
# CHROME_PATH=/usr/bin/google-chrome
# SMOKE_STRICT=1
